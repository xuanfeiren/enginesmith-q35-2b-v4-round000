+@nki.jit
+def step(toks, pos, posf, emb, lnf, wlm, vofs, cos, sin, rot,
+         l_ln1, l_wqkv, l_wz, l_wab, l_convw, l_alog, l_dtb, l_normw, l_wout, l_ln2, l_wg, l_wu, l_wd,
